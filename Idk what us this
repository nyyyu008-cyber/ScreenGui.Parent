-- ฟังก์ชันสร้างปุ่มสลับการทำงาน (Toggle Button)
local function CreateToggle(name, defaultState, callback)
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Parent = ScrollingFrame
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    ToggleBtn.Size = UDim2.new(1, -10, 0, 40)
    ToggleBtn.Font = Enum.Font.SourceSansBold
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.TextSize = 15
    ToggleBtn.TextXAlignment = Enum.TextXAlignment.Left
    
    local state = defaultState
    local function updateText()
        ToggleBtn.Text = "   " .. name .. ": " .. (state.Value and "[ ON ]" or "[ OFF ]")
        ToggleBtn.BackgroundColor3 = state.Value and Color3.fromRGB(0, 80, 0) or Color3.fromRGB(45, 45, 45)
    end
    
    state.Value = defaultState
    updateText()
    
    ToggleBtn.MouseButton1Click:Connect(function()
        state.Value = not state.Value
        updateText()
        callback(state.Value)
    end)
end

