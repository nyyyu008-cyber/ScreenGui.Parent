-- Book ESP
local espState = {Value = false}
CreateToggle("Book ESP (มองเห็นสมุดทะลุกำแพง)", espState, function(enabled)
    task.spawn(function()
        while espState.Value do
            pcall(function()
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj.Name:lower():find("notebook") or obj.Name:lower():find("book") then
                        if not obj:FindFirstChild("HighlightBox") then
                            local hl = Instance.new("Highlight")
                            hl.Name = "HighlightBox"
                            hl.Adornee = obj
                            hl.FillColor = Color3.fromRGB(0, 255, 255)
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.Parent = obj
                        end
                    end
                end
            end)
            task.wait(2)
        end
        -- ลบ Highlight ออกเมื่อปิด
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:FindFirstChild("HighlightBox") then
                obj.HighlightBox:Destroy()
            end
        end
    end)
end)

-- Auto Notebook Collector
local autoCollectState = {Value = false}
CreateToggle("Auto Notebook Collector (เก็บสมุดออโต้)", autoCollectState, function(enabled)
    task.spawn(function()
